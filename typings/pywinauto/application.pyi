from typing import overload

def process_module(process_id: int) -> str: ...

class ProcessNotFoundError(Exception): ...

class Application:
    process: int
    def __init__(self, backend: str = "uia") -> None: ...
    @overload
    def connect(self, *, path: str, timeout: float = 0) -> Application: ...
    @overload
    def connect(self, *, process: int, timeout: float = 0) -> Application: ...
    def start(self, cmd_line: str, *, work_dir: str, timeout: float = 10) -> Application: ...
